/// @title PolyGuard Minimal-Gas Security Vault (Huff EVM Low-Level Assembly)
/// @notice Ultra-efficient EVM bytecode contract eliminating Solidity compiler overhead
/// @author PolyGuard Security Kernel
/// @license MIT

#define function deposit() payable returns ()
#define function withdraw(uint256) nonpayable returns ()
#define function getBalance(address) view returns (uint256)

#define constant BALANCE_SLOT = 0x00
#define constant OWNER_SLOT = 0x01
#define constant EMERGENCY_PAUSE_SLOT = 0x02

#define macro DEPOSIT() = takes (0) returns (0) {
    // Check if emergency paused (slot 0x02 == 1)
    0x02 sload
    0x01 eq paused_revert jumpi

    // Get caller address and compute storage slot: keccak256(caller . BALANCE_SLOT)
    caller              // [msg.sender]
    0x00 mstore         // [] -> store caller in memory
    0x20 0x00 sha3      // [storage_slot] -> keccak256(msg.sender)
    
    // Load existing balance, add callvalue, store back
    dup1 sload          // [current_balance, storage_slot]
    callvalue add       // [new_balance, storage_slot]
    swap1 sstore        // [] -> update balance in storage
    stop

    paused_revert:
        0x00 0x00 revert
}

#define macro GET_BALANCE() = takes (0) returns (0) {
    0x04 calldataload   // [address]
    0x00 mstore
    0x20 0x00 sha3      // [storage_slot]
    sload               // [balance]
    0x00 mstore
    0x20 0x00 return
}

#define macro MAIN() = takes (0) returns (0) {
    0x00 calldataload 0xE0 shr // [selector]
    
    dup1 0xd0e30db0 eq deposit_jump jumpi
    dup1 0xf8b2cb4f eq balance_jump jumpi
    
    0x00 0x00 revert

    deposit_jump:
        DEPOSIT()
    balance_jump:
        GET_BALANCE()
}
