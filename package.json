{
  "name": "kallipolis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest run __tests__/*.benchmark.test.ts",
    "test:e2e": "vitest run __tests__/web3.e2e.test.ts",
    "test:watch": "vitest",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@xenova/transformers": "^2.17.2",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^11.3.19",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@types/yamljs": "^0.2.34",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
