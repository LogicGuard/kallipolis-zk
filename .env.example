# Kallipolis ZK v3.0 Backend Environment Variables
# -----------------------------------------------------------------------------
# SECURITY WARNING: DO NOT COMMIT REAL SECRETS TO REPOSITORIES!
# For production deployments, inject API keys and secrets via Google Cloud
# Secret Manager, HashiCorp Vault, or environment variables in CI/CD pipelines.
# -----------------------------------------------------------------------------

# Server & Auth
SECRET_KEY=kallipolis-v3-super-secret-jwt-key-change-in-production
FIREBASE_PROJECT_ID=kallipolis-v3

# Polygon RPC Nodes
POLYGON_MAINNET_RPC=https://polygon-rpc.com
POLYGON_ZKEVM_RPC=https://zkevm-rpc.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# AI & Gemini API
GEMINI_API_KEY=
OPENAI_API_KEY=

# Databases, Cache & Infrastructure
DATABASE_URL=sqlite+aiosqlite:///./kallipolis.db
REDIS_URL=redis://localhost:6379/0
FOUNDATIONDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster
OLLAMA_HOST=http://localhost:11434
JWT_SECRET=kallipolis-v3-super-secret-jwt-key-change-in-production

# Observability & Metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
