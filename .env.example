# Kallipolis ZK v3.0 Backend Environment Variables

# Server & Auth
SECRET_KEY=kallipolis-v3-super-secret-jwt-key-change-in-production
FIREBASE_PROJECT_ID=kallipolis-v3

# Polygon RPC Nodes
POLYGON_MAINNET_RPC=https://polygon-rpc.com
POLYGON_ZKEVM_RPC=https://zkevm-rpc.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# AI & Gemini API
GEMINI_API_KEY=

# Databases & Cache
DATABASE_URL=sqlite+aiosqlite:///./kallipolis.db
REDIS_URL=redis://localhost:6379/0
